{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scope_kind", "scope_id", "query", "source_kinds", "limit"],
  "properties": {
    "scope_kind": {
      "type": "string"
    },
    "scope_id": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "source_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "title": "SearchRequest"
}
